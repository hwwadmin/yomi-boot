# 默认：文本文件检出 LF，提交时规范化为 LF
* text=auto eol=lf

# Windows 脚本 / 工程文件使用 CRLF（与 .editorconfig 保持一致）
# Git 不支持花括号展开，需逐条声明
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.reg   text eol=crlf

# 二进制文件不参与换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.svg   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.wasm  binary
